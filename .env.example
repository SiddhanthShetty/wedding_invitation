# Copy this file to .env.local for local development.
# On Vercel / Netlify, add the same names under the project's environment variables.
# Never commit real values.

# ── Public site ──────────────────────────────────────────────────────────────
# The final public address of the invitation, e.g. https://sweekruti-siddhanth.com
# The QR code, sharing links, canonical URL and link previews are only produced
# once this is a real https address (never localhost or a preview URL).
NEXT_PUBLIC_SITE_URL=

# Set to "true" to let search engines index the invitation. Leave empty to keep it unlisted.
NEXT_PUBLIC_ALLOW_INDEXING=

# ── RSVP storage (Supabase) ──────────────────────────────────────────────────
# Project URL, from Supabase → Project Settings → API.
SUPABASE_URL=
# Server-only secret key (the "service_role" or "sb_secret_..." key). Never expose it
# to the browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: set to "file" to store RSVPs in .data/rsvps.json
# instead of Supabase. Ignored in production.
RSVP_STORAGE=

# ── Admin area (/admin) ──────────────────────────────────────────────────────
# A long passphrase the couple will use to sign in. The live site requires at least
# 12 characters; a shorter one is accepted only when testing on your own computer.
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie (at least 32 characters).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=
